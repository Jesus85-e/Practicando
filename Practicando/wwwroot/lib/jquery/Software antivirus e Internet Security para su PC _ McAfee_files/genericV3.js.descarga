//News letter email validation and submit
$('#newsLetterSignUp').on("click", function () {
    //    $("#errorMsgDiv").hide();
    //    var hasError = false;
    //    var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,4})?$/;

    var emailaddressVal = $("#newsLetterEmail").val();
    //    if (emailaddressVal == '' || !emailReg.test(emailaddressVal)) {
    if (emailaddressVal == '') {
        //$("#errorMsgDiv").show();
        return false;
    }
    else {
        window.location.href = "/Root/NewsLetter.aspx?ea=" + emailaddressVal.replace('@', '%40') + "&sid=1";
        return false;
    }
	
});
function RefreshParentPage() {
    window.location.href = window.location.href;
}
function DisplayLogin() {
    if (document.getElementById("exportControlCheck").value == "1"){ document.location.href = document.getElementById

("exportControlURL").value; }
    else {
        var frameSignIn = document.getElementById('iFrameSignIn');
        var loadingDisplay = $("#ajaxLoginLoad");
        loadingDisplay.css("display", "block");

        if (frameSignIn.onload == null) {
            frameSignIn.onload = function () {
                loadingDisplay.css("display", "none");
            };

            if (window.attachEvent){ frameSignIn.attachEvent('onload', frameSignIn.onload); }
        }

        $(".loginHolder").show();
        $(frameSignIn).show();
        $(frameSignIn).prop("src", "https://home.mcafee.com/Secure/Protected/InLineLogin.aspx");
    }
}
function CloseInLineLogin() {
    $("iframe#iFrameSignIn").prop("src", "about:blank");
    $(".loginHolder").hide();
}

function IsWin8() {
    var userAgent = navigator.userAgent;
    return (/Windows NT 6(\.2|\.3)/i.test(userAgent));
}

/** for gtm2014 MFP-Android (added because used same 2013 classes) **/
if ($(".benefit-blist2").children().hasClass("pcTab")) {
    $("*:not(li) > .benefit-blist2 > .pcTab > li:odd").addClass("odd-row").removeProp("onclick");
    $("*:not(li) > .benefit-blist2 > .pcTab > li:even").addClass("even-row").removeProp("onclick");
    $("*:not(li) > .benefit-blist2 >.pcTab > li:last").addClass("last");
}

