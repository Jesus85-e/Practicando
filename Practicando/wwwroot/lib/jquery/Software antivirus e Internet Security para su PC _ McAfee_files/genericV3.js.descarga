$('#prodFeature .expCntr, #prodFeature .colCntr, .prodfeat .expcntr, .prodfeat .colcntr').on("click", function(){
if(!$(this).hasClass('disable-col')){
var state = $(this).prop('class').toLowerCase();
	$('.compare tbody').find('th').each(function(){
		if(state==="expcntr")
		{
		$(this).addClass('ExpandIcon').removeClass('CollapseIcon');
		}
		else if(state==='colcntr')
		{
			$(this).addClass('CollapseIcon').removeClass('ExpandIcon');
		}
	});
	$(this).addClass('disable-col');
	$(this).siblings().removeClass('disable-col');
	}
});
